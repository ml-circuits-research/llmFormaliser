// ============================================================
//  CNL-E  v0.1  -  event-based controlled language
//  Lark grammar.  Use: Lark(..., parser="lalr", lexer="contextual")
//  LALR(1) with no conflicts  =>  every valid text has exactly one parse.
// ============================================================

start: _NL* line (_NL+ line)* _NL*

// ---- 1. LINES: one line = one event, with a force marker -----------------
line: EVREF ":" clause              -> fact               // E1:   asserted by the speaker
    | EVREF "*" ":" clause          -> unasserted         // E1*:  content only (said, wanted, if...)
    | EVREF "?" ":" clause          -> question           // E1?:  direct question
    | EVREF "*" "?" ":" clause      -> embedded_question  // E1*?: question inside another event
    | EVREF "!" ":" clause          -> directive          // E1!:  order, request, query
    | EVREF "^" ":" expressive      -> expressive         // E1^:  interjection, greeting, thanks

// ---- 2. CLAUSES ----------------------------------------------------------
?clause: verbal | logic | mathclause

verbal: term NOT? WORD complement? tag* flag*      // WHO [not] VERB [WHAT] [tags] [FLAGS]

logic: "either" EVREF (OR EVREF)+                  -> either
     | "both" EVREF (AND EVREF)+                   -> both
     | NOT EVREF                                   -> negation

mathclause: formula tag* flag*                     // E1: $x^2 + 1 = 0$

expressive: (property | STRING) tag* flag*         // E1^: thanks [for: help-1]

// ---- 3. TERMS: what can fill a slot ---------------------------------------
term: unit (conj unit)*                            // John and Mary
unit: FOCUS? alt                                   // only John
alt: atom ("|" atom)*                              // John|Peter  = ambiguous referent, first is preferred
?conj: AND | OR

?atom: np
     | NAME                                        // John, New_York, John-2
     | PRON                                        // I, you, we, this, that
     | EVREF                                       // another event as argument
     | WH                                          // ?who ?what ?when ?where ?why ?how
     | BLANK                                       // _  = argument not expressed in the text
     | STRING                                      // "literal text"
     | formula                                     // $...$
     | quantity                                    // 5_km  >500_euro
     | DATE | TIME                                 // 2026-10-12  10:30

np: quant? words? NOUN npmod*                      // every old report-1{on: sale-1+}
quant: QUANT | (CMP | APPROX)? NUMBER | WHQ
npmod: "{" WORD ":" NOT? value "}"                 // modifier attached to the NOUN

complement: term | property | number | WHQ
property: words (conj words)*                      // very long / good doctor / tall and strong
words: WORD+
number: (CMP | APPROX)? NUMBER                     // 42   <=5%
quantity: (CMP | APPROX)? QUANTITY

// ---- 4. TAGS (attached to the VERB) and FLAGS ------------------------------
tag: "[" WORD ":" NOT? value "]"                   // [to: Mary] [mode: not must] [if: E2]
flag: "[" FLAG "]"                                 // [PAST] - closed set, always last
?value: term | property | number | WHQ

// ---- 5. MATH: everything between $ ... $ ----------------------------------
formula: "$" mrel "$"
?mrel: msum ((CMP | EQ | NEQ) msum)*
?msum: mprod (("+" | "-") mprod)*
?mprod: munary (("*" | "/") munary)*
?munary: "-" munary | mpow
?mpow: matom ("^" munary)?
?matom: NUMBER
      | MNAME
      | MNAME "(" mrel ("," mrel)* ")"             -> call
      | "(" mrel ")"

// ---- 6. TERMINALS ----------------------------------------------------------
EVREF.3: /E[0-9]+/
DATE.3: /[0-9]{4}-[0-9]{2}(-[0-9]{2})?/
TIME.3: /[0-9]{1,2}:[0-9]{2}/
QUANTITY.2: /-?[0-9]+(\.[0-9]+)?_[A-Za-z%°][A-Za-z0-9_\/%°]*/
NUMBER: /[0-9]+(\.[0-9]+)?%?/

NOUN.2: /[a-z][a-z0-9_']*-[0-9]+\+?/               // lemma-id: report-1, plural report-1+, the kind itself dog-0
// lemma; multiword joined with _ (give_up). Reserved words can never be ordinary words:
WORD: /(?!(not|and|or|either|both|every|all|each|some|any|no|most|many|few|several|half|not_every|not_all|not_many|only|even|also|you|we)(?![a-z0-9_'-]))[a-z][a-z0-9_']*/
NAME: /[A-Z][A-Za-z0-9_.']*(-[0-9]+)?/
MNAME: /[A-Za-z][A-Za-z0-9_]*/

NOT: "not"
AND: "and"
OR: "or"
// closed word classes; the lookahead keeps "younger", "allow", "nothing-1" ordinary words
PRON.4: /(I|you|we|this|that)(?![A-Za-z0-9_'.-])/
FOCUS.4: /(only|even|also)(?![a-z0-9_'-])/
QUANT.4: /(every|all|each|some|any|no|most|many|few|several|half|not_every|not_all|not_many)(?![a-z0-9_'-])/
WHQ.4: /\?(which|how_many|how_much)(?![a-z0-9_])/
WH: /\?[a-z_]+/
BLANK: "_"
FLAG: "PAST" | "FUTURE" | "PERF" | "PROG" | "HABIT" | "POLITE" | "EMPH"
CMP: /<=|>=|<|>/
APPROX: "~"
EQ: "="
NEQ: "!="
STRING: /"[^"\n]*"/

_NL: /(\r?\n[ \t]*)+/
%ignore /[ \t]+/
%ignore /#[^\n]*/
